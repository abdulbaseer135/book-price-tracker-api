# PostgreSQL Database Configuration (required)
# Copy this file to .env and set your own values. Do not commit .env.
POSTGRES_USER=your_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=your_database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional complete connection string.
# If omitted, it is assembled automatically from the POSTGRES_* parameters above.
# For local (non-Docker) runs, use localhost.
# Docker Compose injects its own DATABASE_URL using the service hostname: postgres
# DATABASE_URL=postgresql+psycopg2://your_user:change_me@localhost:5432/your_database

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SCRAPER_BASE_URL=https://books.toscrape.com/
SCRAPER_REQUEST_TIMEOUT=15.0
SCRAPER_MAX_RETRIES=3
