# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional complete connection string.
# If omitted, it will be assembled automatically from the POSTGRES_* parameters above.
# Inside Docker Compose, POSTGRES_HOST should be the service name: postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/book_tracker

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SCRAPER_BASE_URL=https://books.toscrape.com/
SCRAPER_REQUEST_TIMEOUT=15.0
SCRAPER_MAX_RETRIES=3
